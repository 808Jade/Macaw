<Project>
  <PropertyGroup>
    <MacawToolBuild>$([System.String]::Copy('$(MSBuildProjectDirectory.ToUpperInvariant())\').StartsWith('$(MSBuildThisFileDirectory.ToUpperInvariant()).TOOLS\'))</MacawToolBuild>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Macaw'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)MacawGame.vcxproj">
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.targets" Condition="'$(MacawToolBuild)' != 'true' And Exists('$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.targets')" />
  <ItemDefinitionGroup Condition="'$(MacawToolBuild)' != 'true' And '$(VcpkgEnabled)' == 'true'">
    <ClCompile>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(VcpkgInstalledDir)$(VcpkgTriplet)\include\physx</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <Target Name="CopyPhysXCommon" AfterTargets="AppLocalFromInstalled;AppLocalFromInstalledPreserve" Condition="'$(VcpkgApplocalDeps)' == 'true' And '@(Link)' != '' And Exists('$(TargetDir)PhysX_64.dll')">
    <Copy SourceFiles="$(_ZVcpkgCurrentInstalledDir)$(_ZVcpkgConfigSubdir)bin\PhysXCommon_64.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
  </Target>
  <Target Name="CheckDependencies" BeforeTargets="PrepareForBuild" Condition="'$(MacawToolBuild)' != 'true' And !Exists('$(VcpkgRoot)vcpkg.exe')">
    <Error Text="Run Build.bat from the repository root to prepare tools, restore dependencies, and generate the solution." />
  </Target>
</Project>
